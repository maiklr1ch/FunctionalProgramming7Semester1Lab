cabal-version:      2.4
name:               display-classes
version:            0.1.0.0
synopsis:           Розклад роботи дисплейних класів факультету (Haskell + MySQL)
build-type:         Simple
extra-source-files: schema.sql, README.md

executable display-classes
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    Classes
                    Database
                    Domain
                    Menu
                    Prompt
                    Reports
  build-depends:    base         >= 4.14 && < 5
                  , bytestring
                  , mysql
                  , mysql-simple >= 0.4.9
                  , text
                  , time         >= 1.9
  default-language: Haskell2010
  ghc-options:      -Wall
